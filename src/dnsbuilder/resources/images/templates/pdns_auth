# Dockerfile for PowerDNS Authoritative v{version}
# Auto-generated by DNS Builder

FROM {base_image}

ENV DEBIAN_FRONTEND=noninteractive

{chsrc_install_setup}
{apt_mirror_setup}
{pip_mirror_setup}

# --- STAGE 1: Install Build Dependencies ---
{dep_packages}

# --- STAGE 2: Download and Compile Source ---
WORKDIR /usr/src
RUN wget --no-check-certificate https://downloads.powerdns.com/releases/pdns-{version}.tar.bz2 \
    && tar -xvf pdns-{version}.tar.bz2

WORKDIR /usr/src/pdns-{version}
RUN ./configure --prefix=/usr/local --sysconfdir=/usr/local/etc --localstatedir=/usr/local/var \
        --with-modules="bind gsqlite3" \
    && make -j"$(nproc)" \
    && make install

# --- STAGE 3: Runtime layout ---
RUN groupadd -r pdns && useradd -r -g pdns pdns \
    && mkdir -p /usr/local/etc/includes /usr/local/etc/zones /usr/local/var/lib/pdns \
    && touch /usr/local/etc/pdns.conf \
    && chown -R pdns:pdns /usr/local/etc /usr/local/var

# --- STAGE 4: Install Runtime Utilities ---
{util_packages}

EXPOSE 53/tcp
EXPOSE 53/udp
WORKDIR /usr/local/etc
USER pdns
